// pending: fallthrough; and Y8 switch semantics need B1 and the flip
i64 Grade(i64 s)
{
  i64 r = 0;
  switch (s) {
    case 0:
      r = 1;
    case 1:
    case 2:
      r = 2;
      fallthrough;
    case 3:
      r += 10;
    case 4: break;
    case 5: r = 5;
    case 6: {
      r = 6;
    }
    case 7:
      if (s) { break; }
      r = 7;
      fallthrough;
    default:
      r += 100;
  }
  return r;
}
void main() { for (i64 i = 0; i < 9; i++) { printf("%d ", Grade(i)); } printf("\n"); }
