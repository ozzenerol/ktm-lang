};
.EE
.SS Pool
.EX
struct Pool {
        u64 workerCount,aliveThreads,activeThreads;
        bool running;
        bool failed;
        Error err;
        libc.pthread_cond_t hasWork,noWork;
        libc.pthread_mutex_t lock;
        Worker *workers;
        list.List<Job *> jobs;
        void *privData;
