    defer m.unlock();
.EE
.RE
.PP
or \fBscoped thread.Guard g = m.guard();\fR
.SS Guard
.EX
struct Guard {
    Mutex *m;
};
.EE
.PP
A held Mutex that free() unlocks: \fBscoped thread.Guard g = m.guard();\fR holds m until the end of the block
.SS Cond
.EX
struct Cond {
    i32 state;
    libc.pthread_cond_t c;
};
.EE
.PP
A condition threads wait on while holding a Mutex:
.PP
.RS 4
.EX
    m.lock();
    while (!ready) { c.wait(&m); }
    m.unlock();
.EE
.RE
.PP
and, where ready is set (with m held), c.signal() or c.broadcast()
.SS RwLock
.EX
struct RwLock {
    Mutex m;
    Cond c;
