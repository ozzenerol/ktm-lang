.TE
.PP
A function can switch on the kind:
.PP
.RS 4
.EX
import reflect;

void describe(reflect.Type *t) {
    switch (t.kind) {
        case reflect.Kind.int:    printf("%s: integer, %d bytes, signed %d\en", t.name, t.size, t.isSigned);
        case reflect.Kind.float:  printf("%s: float\en", t.name);
        case reflect.Kind.array:  printf("%s: %d x %s\en", t.name, t.len, t.elem.name);
        case reflect.Kind.slice:  printf("%s: slice of %s\en", t.name, t.elem.name);
        case reflect.Kind.string: printf("%s: String\en", t.name);
        default:                  printf("%s: something else\en", t.name);
    }
}

i32 main() {
    i64 grid[4];
    describe(reflect.typeOf(u16));
    describe(reflect.typeOf(f64));
    describe(reflect.typeOf(grid));
    describe(reflect.typeOf(u8[]));
    describe(reflect.typeOf(String));
    describe(reflect.typeOf(bool));
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
u16: integer, 2 bytes, signed 0
f64: float
i64[4]: 4 x i64
u8[]: slice of u8
String: String
bool: something else
.EE
.RE
.PP
An enum's members carry their names and values:
.PP
.RS 4
.EX
import reflect;

enum Level { debug, info = 5, warn };

i32 main() {
    reflect.Type *t = reflect.typeOf(Level);
    for (auto m : t.members) {
        printf("%s = %d\en", m.name, m.value);
    }
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
debug = 0
info = 5
warn = 6
.EE
.RE
.PP
A derived struct lists its base's fields first:
.PP
.RS 4
.EX
import reflect;

struct Base { i64 id; };
struct Item : Base { u8 *label; };

i32 main() {
    for (auto f : reflect.typeOf(Item).fields) {
        printf("%s ", f.name);
    }
    printf("\en");
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
id label 
.EE
.RE
.SH Values of any type
.PP
\fBreflect.of(x)\fR, for a variable, a field or an element, gives a \fBreflect.Value\fR: its address (\fBptr\fR) and its type (\fBtype\fR). One function can then take a value of any type:
.PP
.RS 4
.EX
import reflect;

void show(reflect.Value v) {
    printf("%s at %d bytes: ", v.type.name, v.type.size);
    if (v.type.kind == reflect.Kind.int) {
        printf("%d\en", reflect.getInt(v));
    } else if (v.type.kind == reflect.Kind.float) {
        printf("%.2f\en", reflect.getFloat(v));
    } else {
        printf("(not a number)\en");
    }
}

i32 main() {
    i32 a = 7;
    f64 b = 2.5;
    u8 *c = "x";
    show(reflect.of(a));
    show(reflect.of(b));
    show(reflect.of(c));
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
i32 at 4 bytes: 7
f64 at 8 bytes: 2.50
u8 * at 8 bytes: (not a number)
.EE
.RE
.PP
\fBreflect.of\fR needs something with an address; a plain value is an error:
.PP
This does not compile:
.RS 4
.EX
import reflect;

i32 main() {
    reflect.Value v = reflect.of(1 + 2);
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
reflect.of takes a variable, a field or an element
.EE
.RE
.SH Fields by name
.PP
\fBreflect.field(v, name)\fR is one field of a struct value, as a \fBreflect.Value\fR; its \fBtype\fR is \fBnull\fR when there is no such field. \fBgetInt\fR/\fBsetInt\fR and \fBgetFloat\fR/\fBsetFloat\fR read and write integers, bools, enums and floats of any size:
.PP
.RS 4
.EX
import reflect;

struct Point { i32 x; i32 y; };
struct Stats { i64 hits; f64 ratio; };

void bump(reflect.Value v, u8[] field) {
    reflect.Value f = reflect.field(v, field);
    if (!f.type) {
        printf("no field %s\en", field);
        return;
    }
    reflect.setInt(f, reflect.getInt(f) + 1);
}

i32 main() {
    Point p = {3, 4};
    Stats s = {10, 0.5};
    bump(reflect.of(p), "y");
    bump(reflect.of(s), "hits");
    bump(reflect.of(s), "misses");
    reflect.setFloat(reflect.field(reflect.of(s), "ratio"), 0.75);
    printf("%d %d | %d %.2f\en", p.x, p.y, s.hits, s.ratio);
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
no field misses
3 5 | 11 0.75
.EE
.RE
.PP
A generic printer walks a struct's fields:
.PP
.RS 4
.EX
import reflect;

struct Server {
    u8[] host;
    i64 port;
    bool tls;
    f64 timeout;
};

void dump(reflect.Value v) {
    for (auto f : v.type.fields) {
        reflect.Value fv = reflect.field(v, f.name);
        printf("%s = ", f.name);
        switch (f.type.kind) {
            case reflect.Kind.int:
            case reflect.Kind.boolean: printf("%d\en", reflect.getInt(fv));
            case reflect.Kind.float:   printf("%.1f\en", reflect.getFloat(fv));
            case reflect.Kind.slice:   printf("%s\en", *(u8[] *)fv.ptr);
            default:                   printf("?\en");
        }
    }
}

i32 main() {
    Server s = {"localhost", 8080, true, 2.5};
    dump(reflect.of(s));
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
host = localhost
port = 8080
tls = 1
timeout = 2.5
.EE
.RE
.PP
The same walk can fill a struct, as a settings loader does:
.PP
.RS 4
.EX
import reflect;

struct Limits {
    i64 maxUsers;
    i64 maxFiles;
    f64 ratio;
};

void setAll(reflect.Value v, i64 n) {
    for (auto f : v.type.fields) {
        reflect.Value fv = reflect.field(v, f.name);
        if (f.type.kind == reflect.Kind.int) {
            reflect.setInt(fv, n);
        }
    }
}

i32 main() {
    Limits l = {0, 0, 0.5};
    setAll(reflect.of(l), 100);
    printf("%d %d %.1f\en", l.maxUsers, l.maxFiles, l.ratio);
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
100 100 0.5
.EE
.RE
.SH Enum names
.PP
\fBreflect.name(e)\fR is the name of an enum value's member, \fB""\fR for a value that isn't one. \fBreflect.nameOf(type, n)\fR names a number, and \fBreflect.enumValue(type, name, &v)\fR finds the value of a name:
.PP
.RS 4
.EX
import reflect;

enum Level { debug, info, warn };

i32 main() {
    Level l = Level.warn;
    printf("%s\en", reflect.name(l));
    printf("%s\en", reflect.nameOf(reflect.typeOf(Level), 1));
    i64 v;
    if (reflect.enumValue(reflect.typeOf(Level), "debug", &v)) {
        printf("debug is %d\en", v);
    }
    printf("[%s]\en", reflect.name((Level)9));
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
warn
info
debug is 0
[]
.EE
.RE
.SH Attributes
.PP
A type's description carries the attributes written on it (see Attributes (see ktm-guide-attributes(7))): \fBType.json\fR, and for each field \fBkey\fR, \fBskip\fR, \fBomitEmpty\fR, \fBenv\fR, \fBrequired\fR, and validation's \fBhasMin\fR/\fBmin\fR, \fBhasMax\fR/\fBmax\fR, \fBemail\fR, \fBurl\fR and \fBoneOf\fR:
.PP
.RS 4
.EX
import json, reflect;

@json struct Account {
    @key("e\-mail") @required u8[] email;
    @skip i64 cache;
    @omitEmpty u8[] note;
};

i32 main() {
    reflect.Type *t = reflect.typeOf(Account);
    printf("json %d\en", t.json);
    for (auto f : t.fields) {
        printf("%s: key %s, skip %d, omitEmpty %d, required %d\en", f.name, f.key, f.skip, f.omitEmpty, f.required);
    }
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
json 1
email: key e\-mail, skip 0, omitEmpty 0, required 1
cache: key cache, skip 1, omitEmpty 0, required 0
note: key note, skip 0, omitEmpty 1, required 0
.EE
.RE
.SH Comparing types
.PP
A type's description is made at compile time, as read-only data, only for the types a program asks about and the types they lead to. A library and a program each have their own copy, so two \fBType\fR pointers for the same type may differ: compare with \fBreflect.same(a, b)\fR, not \fB==\fR\&.
.PP
.RS 4
.EX
import reflect;

struct P { i64 x; };

i32 main() {
    reflect.Type *a = reflect.typeOf(P);
    P p;
    reflect.Type *b = reflect.of(p).type;
    printf("%d %d\en", reflect.same(a, b), reflect.same(a, reflect.typeOf(i64)));
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
1 0
.EE
.RE
.SH What the library builds on it
.PP
\fBjson.encode\fR, \fBjson.decode\fR, \fBconfig.fromEnv\fR, \fBvalidate.check\fR and \fBany ...\fR extras all work through \fBreflect.of(x)\fR (see Variable arguments (see ktm-guide-varargs(7))): they walk the struct's fields and read or write them with the functions above.
.PP
.RS 4
.EX
import json, reflect;

struct Config {
    i64 port;
    i64 workers;
    bool debug;
};

i32 main() {
    Config c = {8080, 4, false};
    json.decode("{\e"workers\e": 16}", reflect.of(c));
    printf("%d %d %d\en", c.port, c.workers, c.debug);
    return 0;
}
.EE
.RE
.PP
Output:
.RS 4
.EX
8080 16 0
.EE
.RE
.PP
Fields the JSON leaves out keep what they had, so defaults survive.
.SH Rules
.IP \(bu 2
\fBreflect.typeOf(T)\fR or \fBreflect.typeOf(expr)\fR is a \fBreflect.Type *\fR; \fBreflect.of(x)\fR a \fBreflect.Value\fR (address and type) of something with an address. Both need \fBimport reflect;\fR\&.
.IP \(bu 2
\fBType.fields\fR lists a struct's fields with their offsets, inherited ones first; \fBType.members\fR an enum's members.
.IP \(bu 2
\fBreflect.field\fR, \fBgetInt\fR/\fBsetInt\fR, \fBgetFloat\fR/\fBsetFloat\fR read and write fields by name.
.IP \(bu 2
\fBreflect.name\fR, \fBnameOf\fR and \fBenumValue\fR map enum values and names.
.IP \(bu 2
Descriptions are compile-time data; compare types with \fBreflect.same\fR\&.
