#include "testhelper.ktm"

/* StrPrint took only `-` and `0` as flags and none of C's length
 * modifiers, %i or %o, ignored an integer precision (`%.3d` gave 7, not
 * 007), and `%.*d` / `%.*x` cut the number to the width instead. It now
 * takes the flags `-0+ #` in any order, the modifiers l ll h hh z j t L q
 * (no-ops: every integer is 64 bits), %i and %o, and an integer
 * precision as C does. The model cases below were generated from C's
 * printf (ll for every modifier). */

#define FF_SRC "./ktm-246-ff.ktm"
#define FF_OUT "./ktm-246-ff.out"

I64 bad = 0, total = 0;

U0 Chk(U8 *got, U8 *exp, U8 *what)
{
  total++;
  if (StrCmp(got, exp)) {
    if (bad < 20) "MISMATCH %s: got [%s] want [%s]\n", what, got, exp;
    bad++;
  }
  Free(got);
}

