/* Print statements and StrPrint print the formats they share alike
 * (not h/hh: a statement is C's printf, which narrows the value) */
u8 *stmtSrc =
"import mem, str;

void Line(u8 *s) { printf(\"%s\\n\", s); mem.free(s); }
void main()
{
  printf(\"[%.3d][%+d][% d][%#x][%#o][%i][%o][%ld][%-6d|][%08.3f][%+.2e][%5s]\\n\",
    7, 5, 5, 255, 8, -7, 8, 5000000000, -42, 3.14159, 1234.5, \"ab\");
  Line(str.formatTo(null, \"[%.3d][%+d][% d][%#x][%#o][%i][%o][%ld][%-6d|][%08.3f][%+.2e][%5s]\",
    7, 5, 5, 255, 8, -7, 8, 5000000000, -42, 3.14159, 1234.5, \"ab\"));
  printf(\"[%X][%#X][%10.4x][%-#10o|][%u][%llu][%zd][%.0d][%5.0d|]\\n\",
    48879, 48879, 255, 8, -1, -1, 9, 0, 0);
  Line(str.formatTo(null, \"[%X][%#X][%10.4x][%-#10o|][%u][%llu][%zd][%.0d][%5.0d|]\",
    48879, 48879, 255, 8, -1, -1, 9, 0, 0));
}
";

i32 main() {
    printf("Test - StrPrint C conversions: ");
    i64 correct = 0, tests = 0;

    tests++;
    bad = 0; total = 0;
    chk(str.formatTo(null, "%.3d", 7), "007", "%.3d");
    chk(str.formatTo(null, "%+d|% d|%+d", 5, 5, -5), "+5| 5|-5", "+ space");
    chk(str.formatTo(null, "%#x|%#X|%#o|%#x|%#o", 255, 255, 8, 0, 0), "0xff|0XFF|010|0|0", "#");
    chk(str.formatTo(null, "%i|%o|%ld|%lld|%hd|%hhu|%zu|%jd", -7, 8, 1, 2, 70000, 300, 4, 5),
            "-7|10|1|2|70000|300|4|5", "modifiers");
    chk(str.formatTo(null, "%.*d|%.*x|%.*d", 5, 42, 3, 255, -1, 9), "00042|0ff|9", ".*");
    chk(str.formatTo(null, "%-+6d|%0+6d|% 06d", 7, 7, 7), "+7    |+00007| 00007", "flag order");
    chk(str.formatTo(null, "%06.3d|%.0d|%5.0d|", 7, 0, 0), "   007||     |", "0 with precision");
    chk(str.formatTo(null, "%+.2f|% f", 1.5, 2.0), "+1.50| 2.000000", "float sign");
    chk(str.formatTo(null, "%d|%.3d", I64_MIN, I64_MIN),
            "-9223372036854775808|-9223372036854775808", "I64_MIN");
    if (!bad) { correct++; }

    tests++;
    bad = 0; total = 0;
    modelCases();
    if (!bad && total == 600) { correct++; }
    else { printf("%d/%d model mismatches\n", bad, total); }

    tests++;
    proc.shell("rm -f " FF_SRC " " FF_OUT);
    fs.writeAll(FF_SRC, stmtSrc, str.len(stmtSrc), libc.O_CREAT | libc.O_RDWR | libc.O_TRUNC);
    proc.shell("$(command -v timeout >/dev/null 2>&1 && echo timeout 60) "
                 "../../ktm ${KTM_INSTALL_DIR:+--install-dir=$KTM_INSTALL_DIR} "
                 "-jit " FF_SRC " > " FF_OUT " 2>&1");
    u8 *out = fs.readAll(FF_OUT);
    u8 *lines[4];
    i64 n = 0;
    u8 *p = out;
    while (p && *p && n < 4) {
        lines[n++] = p;
        while (*p && *p != '\n') { p++; }
        if (*p) { *p++ = '\0'; }
    }
    if (n == 4 && !str.cmp(lines[0], lines[1]) && !str.cmp(lines[2], lines[3])) {
        correct++;
    } else {
        for (i64 i = 0; i < n; i++) { printf("line %d: [%s]\n", i, lines[i]); }
    }
    mem.free(out);
    proc.shell("rm -f " FF_SRC " " FF_OUT);

    test.printResult(correct, tests);
    printf("====\n");
    return 0;
}
