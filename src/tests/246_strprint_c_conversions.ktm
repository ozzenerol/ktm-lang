/* Print statements and StrPrint print the formats they share alike
 * (not h/hh: a statement is C's printf, which narrows the value) */
U8 *stmt_src =
"U0 Line(U8 *s) { \"%s\\n\", s; Free(s); }
U0 Main()
{
  \"[%.3d][%+d][% d][%#x][%#o][%i][%o][%ld][%-6d|][%08.3f][%+.2e][%5s]\\n\",
    7, 5, 5, 255, 8, -7, 8, 5000000000, -42, 3.14159, 1234.5, \"ab\";
  Line(StrPrint(NULL, \"[%.3d][%+d][% d][%#x][%#o][%i][%o][%ld][%-6d|][%08.3f][%+.2e][%5s]\",
    7, 5, 5, 255, 8, -7, 8, 5000000000, -42, 3.14159, 1234.5, \"ab\"));
  \"[%X][%#X][%10.4x][%-#10o|][%u][%llu][%zd][%.0d][%5.0d|]\\n\",
    48879, 48879, 255, 8, -1, -1, 9, 0, 0;
  Line(StrPrint(NULL, \"[%X][%#X][%10.4x][%-#10o|][%u][%llu][%zd][%.0d][%5.0d|]\",
    48879, 48879, 255, 8, -1, -1, 9, 0, 0));
}
";

I32 Main()
{
  "Test - StrPrint C conversions: ";
  I64 correct = 0, tests = 0;

  tests++;
  bad = 0; total = 0;
  Chk(StrPrint(NULL, "%.3d", 7), "007", "%.3d");
  Chk(StrPrint(NULL, "%+d|% d|%+d", 5, 5, -5), "+5| 5|-5", "+ space");
  Chk(StrPrint(NULL, "%#x|%#X|%#o|%#x|%#o", 255, 255, 8, 0, 0), "0xff|0XFF|010|0|0", "#");
  Chk(StrPrint(NULL, "%i|%o|%ld|%lld|%hd|%hhu|%zu|%jd", -7, 8, 1, 2, 70000, 300, 4, 5),
      "-7|10|1|2|70000|300|4|5", "modifiers");
  Chk(StrPrint(NULL, "%.*d|%.*x|%.*d", 5, 42, 3, 255, -1, 9), "00042|0ff|9", ".*");
  Chk(StrPrint(NULL, "%-+6d|%0+6d|% 06d", 7, 7, 7), "+7    |+00007| 00007", "flag order");
  Chk(StrPrint(NULL, "%06.3d|%.0d|%5.0d|", 7, 0, 0), "   007||     |", "0 with precision");
  Chk(StrPrint(NULL, "%+.2f|% f", 1.5, 2.0), "+1.50| 2.000000", "float sign");
  Chk(StrPrint(NULL, "%d|%.3d", I64_MIN, I64_MIN),
      "-9223372036854775808|-9223372036854775808", "I64_MIN");
  if (!bad) correct++;

  tests++;
  bad = 0; total = 0;
  ModelCases;
  if (!bad && total == 600) correct++;
  else "%d/%d model mismatches\n", bad, total;

  tests++;
  System("rm -f " FF_SRC " " FF_OUT);
  FileWrite(FF_SRC, stmt_src, StrLen(stmt_src), O_CREAT | O_RDWR | O_TRUNC);
  System("$(command -v timeout >/dev/null 2>&1 && echo timeout 60) "
         "../../ktm ${KTM_INSTALL_DIR:+--install-dir=$KTM_INSTALL_DIR} "
         "-jit " FF_SRC " > " FF_OUT " 2>&1");
  U8 *out = FileRead(FF_OUT);
  U8 *lines[4];
  I64 n = 0;
  U8 *p = out;
  while (p && *p && n < 4) {
    lines[n++] = p;
    while (*p && *p != '\n') p++;
    if (*p) *p++ = '\0';
  }
  if (n == 4 && !StrCmp(lines[0], lines[1]) && !StrCmp(lines[2], lines[3]))
    correct++;
  else {
    for (I64 i = 0; i < n; i++) "line %d: [%s]\n", i, lines[i];
  }
  Free(out);
  System("rm -f " FF_SRC " " FF_OUT);

  PrintResult(correct, tests);
  "====\n";
  return 0;
}
