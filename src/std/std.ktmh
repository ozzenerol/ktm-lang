/* All prototypes and classes for all functions and classes provided
 * by the library */
/* XXX: now we have a JSON parser it should be easier to generate this code, 
 * JSON might be easier to maintain than this ever growing header file? */
#define SF_ARG1 8
#define SF_ARG2 16
#define SF_ARG3 24
#define SF_ARG4 32
#define SF_ARG5 40
#define SF_ARG6 48
#define SF_ARG7 52
#define SF_ARG8 56

#define TRUE  1
#define FALSE 0
#define NULL  0

/* POSIX file descriptor numbers */
#define STDIN  0
#define STDOUT 1
#define STDERR 2

#define __BUFSIZ__ 2048

#define EXIT_FAIL 1
#define EXIT_OK   0

#define I64_MIN (-0x7fffffffffffffff - 1)
#define I64_MAX 0x7fffffffffffffff
#define U64_MAX 0xffffffffffffffff
#define U8_MAX  0xFF
#define I8_MAX  0x7F
#define I8_MIN  0xFFFFFF80

public class List;
/* A circular doubly linked list of U0 * values. The list itself is a head
 * node (value unused) that links to itself when the list is empty; walk it
 * with `for (List *it = l->next; it != l; it = it->next)`. Values are
 * borrowed: the list never frees them unless you pass a free function. */
public class List
{
  U0 *value;
  List *next, *prev;
};

/* Make `l` (usually a head on the stack or inside a class) an empty list.
 * Such a head must be emptied with ListClear, never ListRelease. */
public U0 ListInit(List *l);
/* A new empty list (a heap-allocated head); free it with ListRelease. */
public List *ListNew();
/* Add `value` at the front. */
public U0 ListPrepend(List *head, U0 *value);
/* Add `value` at the end. */
public U0 ListAppend(List *head, U0 *value);
/* TRUE if the list has no values (also for NULL). */
public Bool ListEmpty(List *l);
/* Remove the first value and return it (a queue's shift): NULL when the
 * list is empty or NULL - a stored NULL looks the same, so check
 * ListEmpty first if you store NULLs. */
public U0 *ListDeque(List *l);
/* Link `new_node` (not in any list) in before `ll`; with `ll` the head,
 * that is the end of the list. */
public U0 ListInsertBefore(List *ll, List *new_node);
/* Insert `value` before the node `ll` (before the head = at the end). */
public U0 ListInsertValueBefore(List *ll, U0 *value);
/* Remove the last value and return it: NULL when the list is empty or NULL
 * (a stored NULL looks the same, see ListDeque). */
public U0 *ListPop(List *l);
/* Free every node, calling FreeValue on each value if it is not NULL,
 * and then the head itself - so only for ListNew lists (use ListClear on a
 * ListInit head). NULL is ignored. */
public U0 ListRelease(List *ll, U0 (*FreeValue)(U0 *arg));
/* The number of values. O(n): it walks the list. 0 for NULL. */
public I64 ListCount(List *ll);
/* Free every node (calling free_value on each value, if given) but keep
 * the head, now empty; works on a ListInit (stack) head. NULL is ignored. */
public U0 ListClear(List *l, U0 (*free_value)(U0 *value) = NULL);
/* Unlink `node` from its list, free it and return its value. Must not be
 * given the list's head (an empty head is left alone, returning NULL).
 * NULL returns NULL. */
public U0 *ListRemove(List *node);
/* The first value without removing it; NULL if the list is empty or
 * NULL (a stored NULL looks the same: check ListEmpty). */
public U0 *ListFirst(List *l);
/* The last value without removing it; NULL if the list is empty or NULL. */
public U0 *ListLast(List *l);
/* Move all of l2's nodes to the start (Prepend) or the end (Append) of
 * l1, then free l2's head: l2 must not be used afterwards, and must have
 * come from ListNew. An empty l2 is just freed; if either is NULL nothing
 * happens. */
public U0 ListMergePrepend(List *l1, List *l2);
public U0 ListMergeAppend(List *l1, List *l2);

#define CSV_EOF   0
#define CSV_ROW   1
#define CSV_FIELD 2

public extern "c" I32 open(U8 *__name, I32 flags, ...);
public extern "c" I32 creat(U8 *__name, U16 __flags);
public extern "c" I32 fcntl(I32 __fd, I32 __flags, ...);
public extern "c" I32 close(I32 __fd);
public extern "c" I64 read(I32 __fd, U0 *__buf, U64 __nbyte);
public extern "c" I64 write(I32 __fd, U0 *__buf, U64 __nbyte);
public extern "c" I64 lseek(I32 __fd, I64 __offset, I32 __whence);
public extern "c" I32 chdir(U8 *path);

public class CsvParser {
  U8 *csv;
  U64 len, off, row_off, nrows, nfields;
  I64 state;
};

/* A slice of the CSV buffer: idx is the field's number in its row (or
 * the row's number), off and len where it is in the buffer. */
public class CsvSlice {
  U64 idx, off, len;
};
/* Start parsing the len bytes at csv. Nothing is copied or allocated:
 * the slices CsvParse returns point into csv, which must outlive them. */
public U0 CsvParserInit(CsvParser *p, U8 *csv, U64 len);
/* The next piece of the CSV: CSV_FIELD for each field of a row, then
 * CSV_ROW for the whole row, CSV_EOF at the end. A slice is the raw
 * text: a quoted field keeps its quotes and doubled "" (`"a ""b"""`),
 * commas and newlines inside quotes don't split, and a row's len
 * includes its line terminator (\n or \r\n). */
public I64 CsvParse(CsvParser *p, CsvSlice *s);

#define CDATE_YEAR_DAYS        365.2425
#define CDATE_YEAR_DAYS_INT    36524250
#define CDATE_BASE_DAY_OF_WEEK 0

/* XXX: Normalise stat ? */
public class cTimespec
{
  I64 tv_sec;
  I64 tv_nsec;
};

public class timeval
{ // c compatability
  I64 tv_sec;     /* seconds since Jan. 1, 1970 */
#ifdef IS_LINUX
  I64 tv_usec;    /* and microseconds (a long) */
#else
  I32 tv_usec;    /* and microseconds (suseconds_t, an int) */
  I32 __pad;      /* C pads the struct to 16 bytes */
#endif
};

public class tm 
{     // c compatability
  I32 tm_sec;  /* seconds after the minute [0-60] */
  I32 tm_min;  /* minutes after the hour [0-59] */
  I32 tm_hour;   /* hours since midnight [0-23] */
  I32 tm_mday;   /* day of the month [1-31] */
  I32 tm_mon;  /* months since January [0-11] */
  I32 tm_year;   /* years since 1900 */
  I32 tm_wday;   /* days since Sunday [0-6] */
  I32 tm_yday;   /* days since January 1 [0-365] */
  I32 tm_isdst;  /* Daylight Savings Time flag */
  I64 tm_gmtoff; /* offset from UTC in seconds */
  I8 *tm_zone;   /* timezone abbreviation */
};

public extern "c" tm *localtime(I64 *clock);
public extern "c" I32 gettimeofday(timeval *tp, U0 *tzp);

/* A date and time in one I64. date is the day number,
 * counting from day 0 = Jan 2 of year 0 (day -1 is Jan 1), and time the
 * fraction of that day in units of 1/2^32 day (about 20 us). The
 * calendar is the proleptic Gregorian one (leap years every 4, not every
 * 100, every 400), also for year 0, a leap year, and the years before
 * it. Years 1 to 3999 have the day numbers of the original calendar, which
 * had no leap day in years divisible by 4000. */
public I64 class CDate {
  U32 time;
  I32 date;
};

/* A broken-down CDate. sec100 is hundredths of a second (0-99) and
 * sec10000 the ten-thousandths below them (0-99), so the fraction of a
 * second is sec100/100 + sec10000/10000. mon is 1-12, day_of_mon 1-31,
 * day_of_week 0 (Sunday) - 6. zone_diff is the offset from UTC as
 * +-hhmm (e.g. 100 for +01:00, -130 for -01:30), set by
 * NowDateTimeStruct and by Str2CDateStruct's %z (CDATE_NO_ZONE without
 * one); Struct2Date and Date2Struct ignore it. */
public class CDateStruct {
  U64 sec10000, sec100, sec, min, hour, day_of_week, day_of_mon, mon;
  I32 year;
  I64 zone_diff;
};
/* zone_diff when there is no zone (Str2CDateStruct without %z); no
 * +-hhmm offset can be this. */
#define CDATE_NO_ZONE I64_MIN

/* Milliseconds since the Unix epoch (1970-01-01 00:00 UTC). */
public U64 NowMilliseconds();
/* Fill _ds with the current local time (the TZ time zone), zone_diff
 * included. */
public U0 NowDateTimeStruct(CDateStruct *_ds);
/* The CDate day number of Jan 1 of year. */
public I64 YearStartDate(I64 year);
/* The day of the week of day number i: 0 Sunday ... 6 Saturday. */
public I64 DayOfWeek(I64 i);
/* Split cdt into _ds (every field but zone_diff, which is left alone). */
public U0 Date2Struct(CDateStruct *_ds, CDate cdt);
/* The CDate of _ds (zone_diff and day_of_week are ignored, _ds is not
 * changed). Out-of-range fields carry over: day_of_mon 32 of January is
 * Feb 1, mon 13 is January of the next year and mon 0 December of the
 * year before. Time fields carry too, into the date as well: hour 24 is
 * midnight of the next day, sec 60 the next minute, and negative values
 * borrow (hour -1 is 23:00 the day before). */
public CDate Struct2Date(CDateStruct *_ds);
/* The day number of the first day of the month that day number i is in. */
public I32 FirstDayOfMon(I64 i);
/* The day number of the last day of the month that day number i is in. */
public I64 LastDayOfMon(I64 i);
/* The day number of Jan 1 of the year that day number i is in. */
public I32 FirstDayOfYear(I64 i);
/* The day number of Dec 31 of the year that day number i is in. */
public I64 LastDayOfYear(I64 i);
/* The current local date and time (the TZ time zone), not UTC. */
public CDate Now();
/* Write ts (seconds and nanoseconds since the Unix epoch, e.g. a Stat
 * time) into buf as UTC ISO 8601, "2026-07-05T14:30:00.123456789Z":
 * 30 characters and a NUL, so buf needs 31 bytes. Uses the proleptic
 * Gregorian calendar, as CDate does. */
public U0 IsoFromTimespec(cTimespec *ts, U8 *buf);

/* The `order` of a deleted hash table node (a tombstone) */
#define HT_DELETED 0x7fffffffffffffff

/* Growable arrays: `entries[0..size)` are the values, and the vector
 * owns `entries`. `size` and `entries` can be read directly, and
 * `for (I64 x : v)` walks the values; push, pop and set go through the
 * functions so the storage can grow. */
public class IntVec
{
  I64 size;
  I64 *entries;
};

/* A growable array of U0 * values; see IntVec. The values are borrowed
 * unless a free function is passed to PtrVecRelease. */
public class PtrVec
{
  I64 size;
  U0 **entries;
};

/* A growable array of F64 values; see IntVec. */
public class FloatVec 
{
  I64 size;
  F64 *entries;
};

/* Sort arr[low..high] in place (note the order: high before low).
 * `_compare_fn(a, b)` returns TRUE when `a` must come before `b` - a
 * "less than", not a C-style -1/0/1 comparator, which leaves the array
 * unsorted. Not stable; O(n log n), also on sorted, reversed and
 * all-equal input. IntVecSort/FloatVecSort/PtrVecSort use it. */
U0 QSortGeneric(U0 **arr, I64 high, I64 low, 
    I64 (*_compare_fn)(U0 *_arg1, U0 *_arg2));

/* A new empty vector with room for `size` values before it has to grow
 * (its initial capacity). A size below 1 (0 or negative) is taken as 1. */
public FloatVec *FloatVecNew(I64 size = 32);
/* How many values fit before the next push has to grow the storage. */
public U64 FloatVecCapacity(FloatVec *vec);
/* Append `value`, growing the storage (doubling it) when needed. */
public U0 FloatVecPush(FloatVec *vec, F64 value);
/* Remove and return the last entry. When empty, returns -1.0 and sets
 * *_ok to FALSE; `_ok` may be NULL if you don't need to tell. */
public F64 FloatVecPop(FloatVec *vec, Bool *_ok = NULL);
/* The entry at `idx`. An index outside [0, size) prints
 * "FloatVecGet: index N out of range (size M)" on stderr and exits with 1. */
public F64 FloatVecGet(FloatVec *vec, I64 idx);
/* Replace the entry at `idx`; out of range prints an error and exits,
 * like FloatVecGet. */
public U0 FloatVecSet(FloatVec *vec, I64 idx, F64 value);
/* The last entry without removing it; -1.0 and *_ok = FALSE when empty. */
public F64 FloatVecLast(FloatVec *vec, Bool *_ok = NULL);
/* Set the size to 0; the storage is kept for reuse. */
public U0 FloatVecClear(FloatVec *vec);
/* Free the storage and the vector. NULL is ignored. */
public U0 FloatVecRelease(FloatVec *vec);
/* Sort ascending, in place (not stable, O(n log n)). */
public U0 FloatVecSort(FloatVec *vec);

/* A new empty vector with room for `size` values before it has to grow
 * (its initial capacity). A size below 1 (0 or negative) is taken as 1. */
public IntVec *IntVecNew(I64 size = 32);
/* How many values fit before the next push has to grow the storage. */
public U64 IntVecCapacity(IntVec *vec);
/* Append `value`, growing the storage (doubling it) when needed. */
public U0 IntVecPush(IntVec *vec, I64 value);
/* Remove and return the last entry. When empty, returns -1 and sets
 * *_ok to FALSE; `_ok` may be NULL if you don't need to tell. */
public I64 IntVecPop(IntVec *vec, Bool *_ok = NULL);
/* The entry at `idx`. An index outside [0, size) prints
 * "IntVecGet: index N out of range (size M)" on stderr and exits with 1. */
public I64 IntVecGet(IntVec *vec, I64 idx);
/* Replace the entry at `idx`; out of range prints an error and exits,
 * like IntVecGet. */
public U0 IntVecSet(IntVec *vec, I64 idx, I64 value);
/* The last entry without removing it; -1 and *_ok = FALSE when empty. */
public I64 IntVecLast(IntVec *vec, Bool *_ok = NULL);
/* Set the size to 0; the storage is kept for reuse. */
public U0 IntVecClear(IntVec *vec);
/* Free the storage and the vector. NULL is ignored. */
public U0 IntVecRelease(IntVec *vec);
/* Sort ascending, in place (not stable, O(n log n)). */
public U0 IntVecSort(IntVec *vec);

/* A new empty vector with room for `size` values before it has to grow
 * (its initial capacity). A size below 1 (0 or negative) is taken as 1. */
public PtrVec *PtrVecNew(I64 size = 32);
/* How many values fit before the next push has to grow the storage. */
public U64 PtrVecCapacity(PtrVec *vec);
/* Append `value`, growing the storage (doubling it) when needed. */
public U0 PtrVecPush(PtrVec *vec, U0 *value);
/* Remove and return the last entry. When empty, returns NULL and sets
 * *_ok to FALSE; `_ok` may be NULL if you don't need to tell (but a
 * stored NULL then looks like an empty vector). */
public U0 *PtrVecPop(PtrVec *vec, Bool *_ok = NULL);
/* The entry at `idx`. An index outside [0, size) prints
 * "PtrVecGet: index N out of range (size M)" on stderr and exits with 1. */
public U0 *PtrVecGet(PtrVec *vec, I64 idx);
/* Replace the entry at `idx`; out of range prints an error and exits,
 * like PtrVecGet. The old value is not freed. */
public U0 PtrVecSet(PtrVec *vec, I64 idx, U0 *value);
/* The last entry without removing it; NULL and *_ok = FALSE when empty. */
public U0 *PtrVecLast(PtrVec *vec, Bool *_ok = NULL);
/* Set the size to 0; the storage is kept for reuse, the values are not
 * freed. */
public U0 PtrVecClear(PtrVec *vec);
/* Free the storage and the vector, first calling `_free_value` on every
 * value if it is given (e.g. `&Free`). NULL is ignored. */
public U0 PtrVecRelease(PtrVec *vec, U0 (*_free_value)(U0 *_val) = NULL);
/* Sort in place with `_compare_fn(a, b)` returning TRUE when `a` comes
 * before `b` (a "less than", not a C-style -1/0/1 comparator). Not
 * stable; O(n log n). */
public U0 PtrVecSort(PtrVec *vec,
                     I64 (*_compare_fn)(U0 *_arg1, U0 *_arg2));

/* An IntMap entry, as IntMapIter hands it out: `key` and `value` are the
 * caller's; `order` is the map's bookkeeping. */
public class IntMapNode
{
  I64 key;
  U0 *value;
  I64 order; /* Position in the map's `indexes`; HT_DELETED once deleted */
};

/* A StrMap entry, as StrMapIter hands it out: `key` is the pointer the map
 * stores (not a copy), `key_len` its StrLen. */
public class StrMapNode
{
  U8 *key;
  I64 key_len;
  U0 *value;
  I64 order; /* Position in the map's `indexes`; HT_DELETED once deleted */
};

/* A hash table from I64 keys to U0 * values. `size` is the number of
 * entries; `capacity` the number of slots (a power of two), which grows
 * when the entries and deleted holes reach 60% of it and never shrinks.
 * The other fields are internal. */
public class IntMap
{
  U64 size;     /* How many entries are in the hashtable */
  U64 capacity; /* How many slots the entries array has, a power of 2 */
  U64 mask;     /* capacity - 1: `hash & mask` is the home slot */
  IntVec *indexes; /* The slot of every entry, in insertion order, with
                    * HT_DELETED for deleted ones: iteration walks this */
  U64 threashold; /* Rebuild when `indexes` reaches this (60% of capacity) */
  U0 (*_free_value)(U0 *value); /* User defined callback for freeing values */
  IntMapNode **entries; /* The slots */
};

/* A hash table from NUL-terminated strings to U0 * values; see IntMap for
 * the fields. The map stores the key pointers it is given, it does not
 * copy them. */
public class StrMap
{
  U64 size;     /* How many entries are in the hashtable */
  U64 capacity; /* How many slots the entries array has, a power of 2 */
  U64 mask;     /* capacity - 1: `hash & mask` is the home slot */
  IntVec *indexes; /* The slot of every entry, in insertion order, with
                    * HT_DELETED for deleted ones: iteration walks this */
  U64 threashold; /* Rebuild when `indexes` reaches this (60% of capacity) */
  U0 (*_free_value)(U0 *_value); /* User defined callback for freeing values */
  U0 (*_free_key)(U0 *_key); /* User defined callback for freeing keys */
  StrMapNode **entries; /* The slots */
};

/* A new, empty map with room for `capacity` slots: rounded up to a power
 * of two, at least 8; a negative request gets 8 and one above 2^28 slots
 * gets 2^28 (the map still grows past it). NULL when out of memory. */
public StrMap *StrMapNew(U64 capacity = 32);
/* Map `key` to `value`; TRUE, or FALSE when out of memory or `map` or
 * `key` is NULL. A new key's pointer is stored, not copied, so it must
 * live as long as the map. Setting a key that is there replaces the
 * value and keeps the stored key: with destructors registered, the
 * replaced value is freed and so is the key you passed (unless it is the
 * stored key or the new value). */
public Bool StrMapSet(StrMap *map, U8 *key, U0 *value);
/* TRUE when the `key_len` bytes at `key` are a key of the map (`key` need
 * not be NUL-terminated there) */
public Bool StrMapHasLen(StrMap *map, U8 *key, I64 key_len);
/* TRUE when `key` is in the map; FALSE also for a NULL map or key */
public Bool StrMapHas(StrMap *map, U8 *key);
/* StrMapGet for the `key_len` bytes at `key` */
public U0 *StrMapGetLen(StrMap *map, U8 *key, I64 key_len, Bool *_ok = NULL);
/* The value of `key`, or NULL when it is missing. A stored NULL also gives
 * NULL: pass `_ok`, set to TRUE when the key is there, to tell them
 * apart. */
public U0 *StrMapGet(StrMap *map, U8 *key, Bool *_ok = NULL);
/* Register a destructor for values, run when a value is replaced, deleted,
 * cleared or released */
public U0 StrMapSetFreeValue(StrMap *map, U0 (*_free_value)(U0 *value));
/* Register a destructor for keys, run when a key is deleted, cleared or
 * released, and on a duplicate key passed to StrMapSet. A pointer that is
 * both a key and its value is freed once. */
public U0 StrMapSetFreeKey(StrMap *map, U0 (*_free_key)(U0 *key));
/* Free the map, running the destructors on every entry. NULL is a no-op. */
public U0 StrMapRelease(StrMap *map);
/* Double the capacity; FALSE when out of memory. The map grows by itself;
 * this is for presizing. */
public Bool StrMapResize(StrMap *map);
/* Remove `key`, running the destructors on its key and value; FALSE when
 * it was not there. Safe while iterating. */
public Bool StrMapDelete(StrMap *map, U8 *key);
/* Remove every entry, running the destructors; the capacity is kept */
public U0 StrMapClear(StrMap *map);
/* The next entry in insertion order: start with `*_idx = 0` and call until
 * FALSE; `*_idx` is an opaque cursor. Deleting entries while iterating is
 * fine; adding them is not (an added entry may be skipped or the table
 * rebuilt). */
public Bool StrMapIter(StrMap *map, I64 *_idx, StrMapNode **_node);
/* StrMapIter giving only the values */
public Bool StrMapValueIter(StrMap *map, I64 *_idx, U0 **_value);
/* StrMapIter giving only the keys */
public Bool StrMapKeyIter(StrMap *map, I64 *_idx, U8 **_key);
/* `{[key] => value, ...}` in insertion order, each value turned into a
 * string by `stringify_value` (whose result is freed); free the result */
public U8 *StrMapToString(StrMap *map, U8 *(*stringify_value)(U0 *));
/* `{key, ...}` in insertion order; free the result */
public U8 *StrMapKeysToString(StrMap *map);


/* Map `key` to `value`; TRUE, or FALSE when out of memory or `map` is
 * NULL. Setting a key that is there replaces the value, freeing the old
 * one if a destructor is registered. */
public Bool IntMapSet(IntMap *map, I64 key, U0 *value);
/* TRUE when `key` is in the map; FALSE also for a NULL map */
public Bool IntMapHas(IntMap *map, I64 key);
/* The value of `key`, or NULL when it is missing. A stored NULL or 0 also
 * gives NULL: pass `_ok`, set to TRUE when the key is there, to tell them
 * apart. */
public U0 *IntMapGet(IntMap *map, I64 key, Bool *_ok = NULL);
/* A new, empty map; the capacity as for StrMapNew. NULL when out of
 * memory. */
public IntMap *IntMapNew(U64 capacity = 32);
/* Register a destructor for values, run when a value is replaced, deleted,
 * cleared or released */
public U0 IntMapSetFreeValue(IntMap *map, U0 (*_free_value)(U0 *value));
/* Free the map, running the value destructor on every entry. NULL is a
 * no-op. */
public U0 IntMapRelease(IntMap *map);
/* Double the capacity; FALSE when out of memory. The map grows by itself;
 * this is for presizing. */
public Bool IntMapResize(IntMap *map);
/* Remove `key`, running the value destructor; FALSE when it was not
 * there. Safe while iterating. */
public Bool IntMapDelete(IntMap *map, I64 key);
/* Remove every entry, running the value destructor; the capacity is
 * kept */
public U0 IntMapClear(IntMap *map);
/* The next entry in insertion order: start with `*_idx = 0` and call until
 * FALSE; `*_idx` is an opaque cursor. Deleting entries while iterating is
 * fine; adding them is not. */
public Bool IntMapIter(IntMap *map, I64 *_idx, IntMapNode **_node);
/* IntMapIter giving only the values */
public Bool IntMapValueIter(IntMap *map, I64 *_idx, U0 **_value);
/* IntMapIter giving only the keys */
public Bool IntMapKeyIter(IntMap *map, I64 *_idx, I64 *_key);
/* `{[key] => value, ...}` in insertion order, each value turned into a
 * string by `stringify_value` (whose result is freed); free the result */
public U8 *IntMapToString(IntMap *map, U8 *(*stringify_value)(U0 *));
/* `{key, ...}` in insertion order; free the result */
public U8 *IntMapKeysToString(IntMap *map);

/* THREADS ==========*/
#ifdef IS_MACOS
#define __MUTEX_LOCK_PADDING__   56
#define __MUTEX_LOCK_ATTR_SIZE__ 8

#define __THREAD_COND_SIZE__     40
#define __THREAD_CONDATTR_SIZE__ 8
#define __THREAD_SIZE__          8176
#define __THREAD_ATTR_SIZE__     56

/* MACOS definitions */
class pthread_mutex_t 
{
  I64 __sig;
  I8 __opaque[__MUTEX_LOCK_PADDING__];
};

class pthread_mutexattr_t
{
  I64 __sig;
  I8 __opaque[__MUTEX_LOCK_ATTR_SIZE__];
};

class pthread_cond_t
{
  I64 __sig;
  I8 __opaque[__THREAD_COND_SIZE__];
};

class pthread_condattr_t
{
  I64 __sig;
  I8 __opaque[__THREAD_CONDATTR_SIZE__];
};

class pthread_handler_rec;
class pthread_handler_rec
{
  U0 (*__routine)(U0 *__arg); // Routine to call
  U0 *__arg;                  // Argument to pass
  pthread_handler_rec *__next;
};

class pthread_attr_t
{  
  I64 __sig;
  I8 __opaque[__THREAD_ATTR_SIZE__];
};

class pthread_t 
{
  I64 __sig;
  pthread_handler_rec  *__cleanup_stack;
  I8 __opaque[__THREAD_SIZE__];
};

#elifdef IS_LINUX /* Linux definitions, this needs to be auto generated */

/* glibc's bits/pthreadtypes-arch.h: the sizes differ between x86_64 and aarch64 */
#ifdef IS_X86_64
#define __SIZEOF_PTHREAD_MUTEX_T   40
#define __SIZEOF_PTHREAD_ATTR_T    56
#define __SIZEOF_PTHREAD_RWLOCK_T  56
#define __SIZEOF_PTHREAD_BARRIER_T 32

#define __SIZEOF_PTHREAD_MUTEXATTR_T   4
#define __SIZEOF_PTHREAD_COND_T        48
#define __SIZEOF_PTHREAD_CONDATTR_T    4
#define __SIZEOF_PTHREAD_RWLOCKATTR_T  8
#define __SIZEOF_PTHREAD_BARRIERATTR_T 4
#else /* aarch64 */
#define __SIZEOF_PTHREAD_MUTEX_T   48
#define __SIZEOF_PTHREAD_ATTR_T    64
#define __SIZEOF_PTHREAD_RWLOCK_T  56
#define __SIZEOF_PTHREAD_BARRIER_T 32

#define __SIZEOF_PTHREAD_MUTEXATTR_T   8
#define __SIZEOF_PTHREAD_COND_T        48
#define __SIZEOF_PTHREAD_CONDATTR_T    8
#define __SIZEOF_PTHREAD_RWLOCKATTR_T  8
#define __SIZEOF_PTHREAD_BARRIERATTR_T 8
#endif

union pthread_mutexattr_t
{
  I8  __size[__SIZEOF_PTHREAD_MUTEXATTR_T];
  I32 __align;
};

union pthread_condattr_t
{
  I8  __size[__SIZEOF_PTHREAD_CONDATTR_T];
  I32 __align;
};

union pthread_attr_t
{
  I8  __size[__SIZEOF_PTHREAD_ATTR_T];
  I64 __align;
};


/* this is the spiritual equivilent of typedef  */ 
public class pthread_t {
  U64 __padding;
};

class __pthread_list_t;
class __pthread_list_t
{
  __pthread_list_t *__prev;
  __pthread_list_t *__next;
};

class __pthread_mutex_s
{
  I32 __lock;
  U32 __count;
  I32 __owner;
  U32 __nusers;
  I32 __kind;
  I16 __spins;
  I16 __elision;
  __pthread_list_t __list;
};

union pthread_mutex_t 
{
  __pthread_mutex_s __data;
  I8  __size[__SIZEOF_PTHREAD_MUTEX_T];
  I64 __align;
};

union __atomic_wide_counter
{
  U64 __value64;
  class
  {
    U32 __low;
    U32 __high;
  };
};

class __pthread_cond_s
{
  __atomic_wide_counter __wseg;
  __atomic_wide_counter __g1_start;
  U32 __g_regs[2];
  U32 __g_size[2];
  U32 __g1_orig_size;
  U32 __wrefs;
  U32 __g_signals[2];
};

union pthread_cond_t
{
  __pthread_cond_s __data;
  I8 __size[__SIZEOF_PTHREAD_COND_T];
  I64 __align;
};
#endif

class ThreadWorker
{
  pthread_t *th;
  I32 id;
};

public class ThreadWorkerJob;
public class ThreadWorkerJob {
  U0 (*callback)(U0 *priv_data, U0 *argv);
  U0 *argv;
  ThreadWorkerJob *next;
};

public class ThreadPool {
  U64 worker_count, alive_threads, active_threads;
  Bool run;
  pthread_cond_t has_work, no_work;
  pthread_mutex_t lock;
  ThreadWorker *workers;
  List *jobs;
  U0 *priv_data;
};

/* The thread handle is the pointer itself: declare `pthread_t *th;`, pass
 * `&th` to pthread_create and `th` to pthread_join/pthread_detach. On Linux
 * the C pthread_t is an unsigned long, so `th` doesn't point at anything:
 * never dereference it. pthread_create returns 0 or an error number. */
public extern "c" I32 pthread_create(pthread_t **th, U0 *thread_attr = NULL,
                U0 *(*function_ptr)(U0 *_argv), U0 *argv = NULL);
public extern "c" I32 pthread_mutex_init(pthread_mutex_t *lk,
                  pthread_mutexattr_t *mutex_attr = NULL);
public extern "c" I32 pthread_mutex_destroy(pthread_mutex_t *lk);
public extern "c" I32 pthread_mutex_lock(pthread_mutex_t *lk);
public extern "c" I32 pthread_mutex_unlock(pthread_mutex_t *lk);
public extern "c" I32 pthread_join(pthread_t *th, U0 *ptr = NULL);
public extern "c" I32 pthread_cond_broadcast(pthread_cond_t *cond);
public extern "c" I32 pthread_cond_destroy(pthread_cond_t *cond);
public extern "c" I32 pthread_cond_init(pthread_cond_t *cond, pthread_condattr_t *attr = NULL);
public extern "c" I32 pthread_cond_signal(pthread_cond_t *cond);
public extern "c" I32 pthread_cond_wait(pthread_cond_t *cond, pthread_mutex_t *lk);
public extern "c" I32 pthread_exit(U0 *data = NULL);
public extern "c" I32 pthread_detach(pthread_t *th);
public extern "c" I32 pthread_attr_setstacksize(pthread_attr_t *attr, U64 stacksize);
public extern "c" I32 pthread_attr_init(pthread_attr_t *attr);

/* Start a pool of `worker_count` threads. NULL if worker_count <= 0 or a
 * thread can't be created (the ones already started are stopped first). */
public ThreadPool *ThreadPoolNew(I64 worker_count);
/* Queue `callback(pool->priv_data, argv)` to run on one of the workers.
 * `priv_data` is the pool's field (NULL unless you set it), the same for
 * every job; `argv` is this job's. A job queued after ThreadPoolStop never
 * runs: ThreadPoolRelease frees it. A NULL pool is ignored. */
public U0 ThreadPoolEnqueue(ThreadPool *pool, U0 *argv,
           U0 (*callback)(U0 *priv_data, U0 *argv));
/* Block until the queue is empty and no job is running. Called from inside
 * a job it never returns (that job counts as running), nor after
 * ThreadPoolStop with a job still queued. A NULL pool returns at once. */
public U0 ThreadPoolWait(ThreadPool *pool);
/* Run every job still queued, then stop and join the workers. NULL is
 * ignored. */
public U0 ThreadPoolStop(ThreadPool *pool);
/* ThreadPoolStop (queued jobs still run), then free the pool. NULL is ignored. */
public U0 ThreadPoolRelease(ThreadPool *pool);

public extern "c" I32 wait(I32 *statloc);
public extern "c" I32 waitpid(I32 pid, I32 *statlock, I32 options);
public extern "c" I32 fork();
#ifdef IS_X86_64
public _extern _EXIT U0 Exit(I64 exit_code = EXIT_FAIL);
#endif

#ifdef IS_ARM_64
public U0 Exit(I64 exit_code = EXIT_FAIL);
#endif

/* Run `command` with the shell (`sh -c`). Returns the command's exit
 * code (0-255), or -1 if it was killed by a signal or the shell could
 * not be run (also for a NULL command). The shell itself gives 127 for
 * a command it can't find. */
public I64 System(U8 *command);

/* write(2) len bytes of buf to fd: the number written, or -1. */
public I64 Write(I64 fd, U8 *buf, I64 len);

/* errno values (the ones networking code checks most); they differ
 * between Linux and macOS, so compare Errno() with these names. */
#define ENOENT          2               /* No such file or directory (or program) */
#define EINTR           4               /* Interrupted by a signal: retry */
#define EBADF           9               /* Bad file descriptor */
#define ECHILD          10              /* No child process to wait for */
#define EACCES          13              /* Permission denied */
#define EINVAL          22              /* Invalid argument */
#define ENFILE          23              /* Too many open files in the system */
#define EMFILE          24              /* Too many open files in this process */
#define EPIPE           32              /* Write to a closed pipe or socket */
#ifdef IS_LINUX
#define EAGAIN          11              /* Would block: try again later */
#define EADDRINUSE      98              /* Address (port) already in use */
#define EADDRNOTAVAIL   99              /* Address not available on this host */
#define ENETUNREACH     101             /* Network unreachable */
#define ECONNRESET      104             /* Connection reset by the peer */
#define ETIMEDOUT       110             /* Timed out */
#define ECONNREFUSED    111             /* Connection refused */
#define EHOSTUNREACH    113             /* No route to host */
#define EINPROGRESS     115             /* Non-blocking connect started */
#else
#define EAGAIN          35              /* Would block: try again later */
#define EINPROGRESS     36              /* Non-blocking connect started */
#define EADDRINUSE      48              /* Address (port) already in use */
#define EADDRNOTAVAIL   49              /* Address not available on this host */
#define ENETUNREACH     51              /* Network unreachable */
#define ECONNRESET      54              /* Connection reset by the peer */
#define ETIMEDOUT       60              /* Timed out */
#define ECONNREFUSED    61              /* Connection refused */
#define EHOSTUNREACH    65              /* No route to host */
#endif
#define EWOULDBLOCK     EAGAIN          /* Same value on Linux and macOS */

/* The calling thread's C errno: the reason the last failing libc call
 * (socket, connect, read, ...) gave, to compare with the E* names above.
 * Only meaningful right after a call that returned its error value. */
public I32 Errno();
/* Set the calling thread's C errno, e.g. to 0 before a call that only
 * reports errors through errno. */
public U0 SetErrno(I32 err);

/* Signals (each platform's numbers) and signal(3). signal returns
 * the previous handler, or SIG_ERR. SIG_IGN on SIGPIPE makes a write to a
 * closed socket or pipe return -1 with Errno() EPIPE instead of ending
 * the program. */
#define SIGHUP          1               /* Terminal hung up */
#define SIGINT          2               /* Ctrl-C */
#define SIGKILL         9               /* Kill (can't be caught or ignored) */
#define SIGPIPE         13              /* Write to a closed pipe or socket */
#define SIGTERM         15              /* Termination request */
#define SIG_DFL         0               /* The default action */
#define SIG_IGN         1               /* Ignore the signal */
#define SIG_ERR         -1              /* signal() failed */
/* handler is SIG_DFL, SIG_IGN or a U0 F(I32 sig) as (&F)(I64) */
public extern "c" I64 signal(I32 sig, I64 handler);
#define SIGQUIT         3               /* Ctrl-\ */
#define SIGALRM         14              /* alarm() timer */
#define SIGTTIN         21              /* Background read from the terminal */
#define SIGTTOU         22              /* Background write to the terminal */
#ifdef IS_MACOS
#define SIGUSR1         30              /* For the program's own use */
#define SIGUSR2         31
#define SIGCHLD         20              /* A child process ended */
#define SIGSTOP         17              /* Stop (can't be caught or ignored) */
#define SIGTSTP         18              /* Ctrl-Z */
#define SIGCONT         19              /* Continue a stopped process */
#define SA_RESTART      0x2             /* Restart read/write/... after the handler */
#define SA_RESETHAND    0x4             /* Back to SIG_DFL once the handler ran */
#define SA_NODEFER      0x10            /* Don't block the signal in its handler */
#else
#define SIGUSR1         10              /* For the program's own use */
#define SIGUSR2         12
#define SIGCHLD         17              /* A child process ended */
#define SIGCONT         18              /* Continue a stopped process */
#define SIGSTOP         19              /* Stop (can't be caught or ignored) */
#define SIGTSTP         20              /* Ctrl-Z */
#define SA_RESTART      0x10000000      /* Restart read/write/... after the handler */
#define SA_RESETHAND    0x80000000      /* Back to SIG_DFL once the handler ran */
#define SA_NODEFER      0x40000000      /* Don't block the signal in its handler */
#endif

/* sigaction(2) (signals.ktm). A handler runs in the middle of whatever
 * the program was doing, on whichever thread the signal reached, so it
 * may only: store to a global (I64, Bool), call write(2), _exit, kill or
 * raise, and save/restore Errno() around them. Not MAlloc/Free, printing,
 * StrPrint, throw, mutexes or anything else that takes a lock: the
 * interrupted code may hold it. Actions are per process (every thread);
 * a signal sent to the process goes to one thread that doesn't block it
 * (pthread_sigmask, not wrapped here, blocks it per thread). signal()
 * sets the same action as SigHandle(sig, handler, SA_RESTART) on Linux
 * and macOS, and the two can be mixed. */
public class SigAct
{
  I64 handler;  /* SIG_DFL, SIG_IGN, or a U0 F(I32 sig) as (&F)(I64) */
  U64 mask;     /* signals blocked while it runs: SigBit(s) | ... */
  I32 flags;    /* SA_RESTART, SA_RESETHAND, SA_NODEFER */
};
/* The bit for signal sig in SigAct.mask (0 outside 1..64). */
public U64 SigBit(I32 sig);
/* Set the action for sig to *act (unless act is NULL) and store the
 * previous one in *old (unless old is NULL). FALSE on failure, Errno()
 * says why (EINVAL: a bad number, SIGKILL or SIGSTOP). Without
 * SA_RESTART a blocking read, write, accept, ... interrupted by the
 * handler returns -1 with Errno() EINTR; poll() always does. */
public Bool SigAction(I32 sig, SigAct *act, SigAct *old=NULL);
/* SigAction in one call: handler for sig with flags and mask, the
 * previous action in *old if given. */
public Bool SigHandle(I32 sig, I64 handler, I32 flags=SA_RESTART,
                      U64 mask=0, SigAct *old=NULL);
/* Clean shutdown for a poll() loop: after this, SIGINT or SIGTERM sets
 * SigStopRequested and makes the returned fd readable (put it in the
 * poll set; reading it is optional). A second SIGINT or SIGTERM ends the
 * program as usual. The fd is non-blocking and close-on-exec; later calls
 * return the same fd, -1 if the pipe can't be made. Call it once, before
 * starting threads. */
public I32 SigStopInit();
/* TRUE once SIGINT or SIGTERM arrived after SigStopInit. */
public Bool SigStopRequested();
/* Which signal requested the stop (SIGINT or SIGTERM), 0 if none. */
public I32 SigStopSignal();
/* Send sig to the calling thread / to process pid (-pid: its group). */
public extern "c" I32 raise(I32 sig);
public extern "c" I32 kill(I32 pid, I32 sig);

/* Call the shell with `printf`-like formatting. fmt is always formatted,
 * also without arguments, so write %% for a literal %. Returns what
 * System returns: the exit code (0-255), or -1 if the command was killed
 * by a signal, could not be run, or fmt is NULL. */
public I32 Sh(U8 *fmt, ...);
/* Run a shell command, built with `printf`-like formatting (always
 * formatted: %% for a literal %), and return what it printed to stdout
 * in a heap allocated string (Free it). One trailing newline is removed.
 * The exit status is not returned: a failing command gives whatever it
 * printed, often "". stderr is not captured. It returns when the shell
 * exits: what a background job (`cmd &`) prints later is not waited for.
 * Returns NULL if fmt is NULL or the shell can't be started. */
public U8 *Shlurp(U8 *fmt, ...);
/* s in single quotes for sh, as a new string to Free: each ' becomes
 * '\'' and NULL gives ''. The shell expands nothing in it, so use it for
 * any text that goes into a command: q = ShQuote(s); Sh("ls %s", q);
 * Free(q). */
public U8 *ShQuote(U8 *s);

/* Processes (process.ktm): run a program by argv, without a shell (no
 * quoting, nothing in an argument is interpreted), and get its exit
 * status. Each of the child's stdin, stdout and stderr is: */
#define PROC_INHERIT 0  /* ours (the default) */
#define PROC_PIPE    1  /* a pipe; our end is Proc in_fd / out_fd / err_fd */
#define PROC_NULL    2  /* /dev/null */
#define PROC_STDOUT  3  /* stderr only: wherever its stdout goes (2>&1) */
/* Options for ProcSpawn; all zero (or a NULL pointer) are the defaults. */
public class ProcOpts
{
  I64 in, out, err;   /* PROC_* for stdin, stdout, stderr */
  U8 *cwd;            /* working directory; NULL: ours */
  U8 **env;           /* NULL-terminated "NAME=value" list replacing the
                         environment; NULL: ours */
  Bool no_path;       /* argv[0] is a path, not looked up in $PATH */
  Bool new_group;     /* own process group: ProcKill reaches its children */
};
/* A started program. Read the fields, don't write them. */
public class Proc
{
  I32 pid;
  I32 in_fd, out_fd, err_fd; /* our pipe ends, -1 unless PROC_PIPE */
  Bool done;                 /* reaped: exit_code and term_signal are set */
  I64 exit_code;             /* 0-255, or -1 if a signal killed it */
  I32 term_signal;           /* the signal that killed it, else 0 */
  Bool group;
};
/* Start argv[0] (looked up in $PATH unless opts->no_path) with the
 * arguments argv, a NULL-terminated list, never through a shell. The
 * child gets default signal handlers and only fds 0-2. NULL on failure,
 * with Errno() saying why (ENOENT: no such program, EACCES, ...). */
public Proc *ProcSpawn(U8 **argv, ProcOpts *opts=NULL);
/* Wait until p ends: its exit code (0-255), or -1 if a signal killed it
 * (then p->term_signal says which). */
public I64 ProcWait(Proc *p);
/* Without waiting: TRUE once p has ended (then reaped, fields set). */
public Bool ProcDone(Proc *p);
/* Send sig to p, or to its process group if started with new_group.
 * FALSE if p was already reaped or kill fails. */
public Bool ProcKill(Proc *p, I32 sig=SIGTERM);
/* Write input_len bytes of input (none if NULL) to p's stdin and close
 * it, read its stdout and stderr to EOF, then wait for it. *out / *err get
 * the output as a new NUL-terminated string to Free (length in *out_len /
 * *err_len), or NULL for a stream that isn't PROC_PIPE; pass NULL to drop
 * a stream. Everything goes through one poll() loop, so a child writing
 * lots to both outputs, or echoing its input, can't block. A child that
 * stops reading early is fine (no SIGPIPE). Returns what ProcWait does. */
public I64 ProcCommunicate(Proc *p, U8 *input, I64 input_len,
                           U8 **out, I64 *out_len=NULL,
                           U8 **err=NULL, I64 *err_len=NULL);
/* Close our pipe ends and free p (NULL is ignored). A child that is
 * still running is waited for: ProcKill it first to stop it. */
public U0 ProcRelease(Proc *p);
/* Run argv (no shell; stdin /dev/null, stderr inherited) and return its
 * stdout as a new string to Free, with one trailing newline removed; the
 * exit code (as ProcWait) in *code. NULL if it couldn't start. */
public U8 *ProcRun(U8 **argv, I64 *code=NULL);

/* try/catch/throw. The compiler emits the calls to the
 * KTM_ helpers below; user code only reads Fs. */

/* One per `try`, on the stack of the function the try is in (the
 * compiler reserves 256 bytes): the setjmp buffer, then the next outer
 * frame of the same thread. */
public class CatchFrame;
public class CatchFrame
{
  I8 jb[248];
  CatchFrame *prev;
};
/* A thread's exception state: catch_top is its innermost active try
 * (NULL outside any), except_ch the value of its last throw, which a
 * catch handler reads. */
public class HCFs
{
  CatchFrame *catch_top;
  U64 except_ch;
  U0 *coro_cur;   /* coroutines.ktm: running coroutine, NULL outside any */
  U0 *coro_root;  /* coroutines.ktm: save slot for the thread's own stack */
  U0 *coro_cache; /* coroutines.ktm: released stacks kept for reuse */
  I64 coro_cached;/* coroutines.ktm: how many (at most 16) */
};
/* The calling thread's exception state (Fs: the classic name of the
 * current task pointer). A function, so `Fs->except_ch` calls it: each thread has
 * its own, and a throw is caught only by a try of the same thread. */
public HCFs *Fs();
public extern "c" I32 setjmp(U0 *env);
public extern "c" U0 longjmp(U0 *env, I32 val);
/* Make f the calling thread's innermost try; the compiler then calls
 * setjmp(f) in the function that has the try. */
public U0 KTM_PushFrame(CatchFrame *f);
/* Make the try that was active before f the innermost again. Emitted
 * when a try body ends or is left by return/break/continue/goto, and
 * before its catch handler runs, so a throw there goes further out. */
public U0 KTM_TryLeave(CatchFrame *f);
/* `throw(v)`: store v in Fs->except_ch and jump to the catch of the
 * innermost try of the calling thread. With no try it reports v and
 * exits the process with 1, from any thread. */
public U0 KTM_Throw(U64 v);

/* Coroutines (coroutines.ktm): each runs a function on its own stack and
 * pauses with CoroutineYield. Fields are private: use the functions. */
public class Coroutine;
public class Coroutine
{
  U0 *sp;
  U0 *stack_base;
  I64 stack_len;
  Coroutine *resumer;
  U0 *(*fn)(U0 *arg);
  U0 *arg;
  CatchFrame *catch_top;
  U64 except_ch;
  U64 thrown;
  I64 status;
  Bool failed;
  Bool is_root;
};
/* A new coroutine that will run fn(arg) on its own stack of stack_size
 * bytes (0 = 256 KiB; rounded up to whole pages, at least 4) above an
 * inaccessible guard page, so an overflow crashes instead of writing
 * over other memory. Nothing runs until the first CoroutineNext. NULL if
 * the stack can't be mapped. */
public Coroutine *CoroutineNew(U0 *(*fn)(U0 *arg), U0 *arg=NULL,
                               I64 stack_size=0);
/* Run c until it yields or returns. Returns the value it yielded or,
 * once its function has returned (CoroutineDone(c) is then TRUE), the
 * function's return value; NULL if c was already done. `send` becomes
 * the return value of the CoroutineYield c is paused in (the first
 * CoroutineNext ignores it). A throw that leaves c's function goes on
 * from here. Resuming a running coroutine exits with a message. */
public U0 *CoroutineNext(Coroutine *c, U0 *send=NULL);
/* Inside a coroutine: pause and hand value to the CoroutineNext that
 * resumed it; returns the `send` of the CoroutineNext that resumes it
 * again. Outside a coroutine it exits with a message. */
public U0 *CoroutineYield(U0 *value=NULL);
/* TRUE once c's function has returned or thrown (also for NULL). */
public Bool CoroutineDone(Coroutine *c);
/* The running coroutine, NULL on a thread's own stack. */
public Coroutine *CoroutineSelf();
/* Free c (NULL is ignored). Its stack is kept for reuse by the next
 * CoroutineNew of the same size on this thread (up to 16 stacks per
 * thread, unmapped when the thread ends), otherwise unmapped. A
 * coroutine paused in CoroutineYield is dropped where it is; c must not
 * be running. */
public U0 CoroutineRelease(Coroutine *c);

#define M_E         2.71828182845904523536028747135266250   /* e              */
#define M_LOG2E     1.44269504088896340735992468100189214   /* log2(e)        */
#define M_LOG10E    0.434294481903251827651128918916605082  /* log10(e)       */
#define M_LN2       0.693147180559945309417232121458176568  /* loge(2)        */
#define M_LN10      2.30258509299404568401799145468436421   /* loge(10)       */
#define M_PI        3.14159265358979323846264338327950288   /* pi             */
#define M_PI_2      1.57079632679489661923132169163975144   /* pi/2           */
#define M_PI_4      0.785398163397448309615660845819875721  /* pi/4           */
#define M_1_PI      0.318309886183790671537767526745028724  /* 1/pi           */
#define M_2_PI      0.636619772367581343075535053490057448  /* 2/pi           */
#define M_2_SQRTPI  1.12837916709551257389615890312154517   /* 2/sqrt(pi)     */
#define M_SQRT2     1.41421356237309504880168872420969808   /* sqrt(2)        */
#define M_SQRT1_2   0.707106781186547524400844362104849039  /* 1/sqrt(2)      */

